# SECURITY: Change ALL of these before first deployment
# ============================================================
# New API Admin Credentials — MUST be changed from defaults
# Generate with: openssl rand -base64 32
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=

# New API Session Security — Generate with: openssl rand -hex 64
SESSION_SECRET=

# New API JWT Signing Key — Generate with: openssl rand -hex 64
NEW_API_JWT_SECRET=

# Database — Generate with: openssl rand -base64 24
DB_PASSWORD=

# PostgreSQL connection (defaults: root@postgres:5432/new-api)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_DB=new-api

# Container timezone
TZ=Asia/Jakarta

# Redis — Generate with: openssl rand -base64 24
REDIS_PASSWORD=

# 9Router — Generate with: openssl rand -base64 24
ROUTER_PASSWORD=

# Domain for Caddy (required for HTTPS)
DOMAIN=yourdomain.com

# Optional: Crypto secret (defaults to SESSION_SECRET if not set)
# CRYPTO_SECRET=

# ============================================================
# Discord Application (Discord Developer Portal → Application)
# ============================================================
# Bot token — Generate in Developer Portal → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Application ID (also called Client ID) — Developer Portal → General Information
DISCORD_CLIENT_ID=

# Application Secret (also called Client Secret) — Developer Portal → OAuth2 → General
DISCORD_CLIENT_SECRET=

# Public Key — Developer Portal → General Information (required only if using
# the Interactions Endpoint/webhook mode; the gateway bot does not need it)
# DISCORD_PUBLIC_KEY=

# OAuth2 redirect URI — must exactly match the URI configured in
# Developer Portal → OAuth2 → Redirects
DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback

# Server (Guild) ID — right-click your server → Copy Server ID
TARGET_GUILD_ID=

# Invite link shown to users who are not members
DISCORD_INVITE_LINK=https://discord.gg/your-invite

# Public site URL the user lands on after login (HTTPS in production)
SITE_URL=https://yourdomain.com

# Discord API base URL (change only for regional instances or testing)
DISCORD_API_BASE=https://discord.com/api/v10

# ============================================================
# DiscordGate → New API Bridge (for C-03 / M-03)
# ============================================================
# Internal Docker network URL for New API (service name: new-api)
NEW_API_INTERNAL_URL=http://new-api:3000

# New API admin API key (generate in New API admin panel → System → API Keys)
# Must have admin scope to manage users and tokens
NEW_API_ADMIN_TOKEN=

# Default user group for Discord members (must exist in New API)
NEW_API_DEFAULT_GROUP=default

# ============================================================
# Caddy Configuration (for H-01, H-04, M-01, M-04)
# ============================================================
# Public domain for Caddy (required for HTTPS)
SITE_DOMAIN=yourdomain.com

# Email for Let's Encrypt TLS certificates
CADDY_TLS_EMAIL=admin@yourdomain.com

# Comma-separated IPs allowed to access /admin panel
# Example: "1.2.3.4, 5.6.7.8" — use your VPN or office IP
CADDY_ADMIN_ALLOWLIST=127.0.0.1

# ============================================================
# Rate Limiting (DiscordGate sidecar)
# ============================================================
# Requests per minute per Discord user (default: 15)
RATE_LIMIT_RPM=15

# Rate limit window in seconds (default: 60)
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================
# Bot → Sidecar Internal Communication (for Step 08)
# ============================================================
# Internal Docker network URL for DiscordGate sidecar (service name: discord-gate)
DISCORD_GATE_INTERNAL_URL=http://discord-gate:3001

# ============================================================
# Sync Scheduler (for Step 11)
# ============================================================
# How often to sync Discord guild members with DB (minutes)
SYNC_INTERVAL_MINUTES=30

# ============================================================
# Container Images (production overrides)
# ============================================================
# Pin images to specific versions in docker-compose.prod.yml
# NEW_API_IMAGE=your-registry/new-api:v1.0.0